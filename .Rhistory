family = "raleway",
face = "bold",
color = "#4D9C34"
),
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_line(
color = "grey90",
linewidth = 0.3
)
)
# Join espacial: solo puntos dentro de las 3 cuencas (st_within es más estricto que st_intersects)
RSU_cuencas <- st_join(
RSU_sf,
cuencas,
join = st_within,          # más preciso que st_intersects para evitar bordes
left = FALSE               # descarta puntos fuera de cualquier cuenca
) %>%
filter(cuenca %in% c("Aº Colorado - Las Viejas", "Aº La Santiagueña", "Aº Antoñico"))
# KPIs por cuenca
kpi_cuencas <- RSU_cuencas %>%
st_drop_geometry() %>%
count(cuenca, name = "microbasurales")
# Filtrar también el polígono: solo las 3 cuencas de interés
cuencas_filtradas <- cuencas %>%
filter(cuenca %in% c("Aº Colorado - Las Viejas", "Aº La Santiagueña", "Aº Antoñico")) %>%
left_join(kpi_cuencas, by = "cuenca") %>%
mutate(microbasurales = ifelse(is.na(microbasurales), 0, microbasurales))
pal <- colorNumeric(
palette = c("#f2c6e0", "#bf499b"),
domain = cuencas_filtradas$microbasurales
)
leaflet() %>%
addProviderTiles("CartoDB.Positron") %>%
# Cuencas choropleth — solo las 3 filtradas
addPolygons(
data = cuencas_filtradas,            # <-- antes: cuencas_kpi (todas las cuencas)
fillColor = ~pal(microbasurales),
weight = 2,
color = "#4D9C34",
fillOpacity = 0.6,
popup = ~paste0(
"<b>Cuenca:</b> ", cuenca, "<br>",
"<b>Microbasurales:</b> ", microbasurales
),
group = "Cuencas"
) %>%
# Puntos RSU — solo los que cayeron dentro de las 3 cuencas
addCircleMarkers(
data = RSU_cuencas,                  # <-- antes: RSU_sf (todos los puntos)
radius = 2,
color = "#bf499b",
stroke = FALSE,
fillOpacity = 0.85,
popup = ~paste0(
"<b>Cuenca:</b> ", cuenca, "<br>",
"<b>Tipo:</b> ", tipo_residuo
),
group = "Microbasurales"
) %>%
addLayersControl(
overlayGroups = c("Cuencas", "Microbasurales"),
options = layersControlOptions(collapsed = FALSE)
) %>%
addLegend(
"bottomright",
pal = pal,
values = cuencas_filtradas$microbasurales,
title = "Microbasurales por cuenca",
opacity = 0.8
)
leaflet() %>%
addProviderTiles("CartoDB.Positron") %>%
# ─────────────────────────────────────────────
